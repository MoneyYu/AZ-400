# https://docs.microsoft.com/zh-tw/azure/devops/pipelines/ecosystems/kubernetes/aks-template?view=azure-devops

# Create a resource group
az group create --name DemoAksDeploy --location southeastasia

# Create a container registry
az acr create --resource-group DemoAksDeploy --name demo0527acr --sku Basic

# Create a Kubernetes cluster
az aks create \
    --resource-group DemoAksDeploy \
    --name demo0527aks \
    --node-count 1 \
    --enable-addons monitoring \
    --generate-ssh-keys \
    --kubernetes-version 1.19.9